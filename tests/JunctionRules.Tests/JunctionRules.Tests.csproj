<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests of the game-independent core (version gate, driving switch, timing window, IL hasher) plus
       repo checks (copied-file headers, vanilla_copy.py self-test). Plain console runner: no test framework package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../JunctionRules/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
