<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>JunctionRules</AssemblyName>
    <RootNamespace>JunctionRules</RootNamespace>
    <Version>1.0.2</Version>
    <InformationalVersion>1.0.2</InformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <!-- Cities: Skylines II install path. Resolution order (first match wins):
         1) -p:GamePath=... on the dotnet build command line
         2) CS2_PATH environment variable
         3) CSII_INSTALLATIONPATH (set by the official modding toolchain / ~/.config/environment.d/60-cs2-modding.conf)
         4) common Steam library locations -->
    <GamePath Condition="'$(GamePath)' == '' And '$(CS2_PATH)' != ''">$(CS2_PATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' And '$(CSII_INSTALLATIONPATH)' != ''">$(CSII_INSTALLATIONPATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' And Exists('$(HOME)/.local/share/Steam/steamapps/common/Cities Skylines II/Cities2_Data/Managed/Game.dll')">$(HOME)/.local/share/Steam/steamapps/common/Cities Skylines II</GamePath>
    <GamePath Condition="'$(GamePath)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed\Game.dll')">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II</GamePath>
    <ManagedDLLPath>$(GamePath)/Cities2_Data/Managed</ManagedDLLPath>
    <!-- Local mods folder the game loads from. Deploy is OFF unless -p:Deploy=true is passed (stage 1 is a probe
         build: install by hand with the game closed, see PROBE-STAGE1.md). -->
    <ModDeployPath Condition="'$(CSII_LOCALMODSPATH)' != ''">$(CSII_LOCALMODSPATH)/JunctionRules</ModDeployPath>
    <ModDeployPath Condition="'$(ModDeployPath)' == ''">$(LOCALAPPDATA)Low\Colossal Order\Cities Skylines II\Mods\JunctionRules</ModDeployPath>
  </PropertyGroup>

  <!-- Compile against the game's own class libraries (Unity's Mono profile) instead of the .NET Framework reference
       assemblies: the copied game code must bind to exactly what Game.dll binds to. It uses System.MathF, which the
       net472 reference assemblies lack (build note B-01 in DEVIATIONS.md). -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(ManagedDLLPath)/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(ManagedDLLPath)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(ManagedDLLPath)/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(ManagedDLLPath)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Game"><HintPath>$(ManagedDLLPath)/Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><HintPath>$(ManagedDLLPath)/Colossal.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><HintPath>$(ManagedDLLPath)/Colossal.Logging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><HintPath>$(ManagedDLLPath)/Colossal.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><HintPath>$(ManagedDLLPath)/Colossal.IO.AssetDatabase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.PSI.Common"><HintPath>$(ManagedDLLPath)/Colossal.PSI.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(ManagedDLLPath)/Colossal.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><HintPath>$(ManagedDLLPath)/Colossal.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(ManagedDLLPath)/Unity.Entities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(ManagedDLLPath)/Unity.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedDLLPath)/Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Burst"><HintPath>$(ManagedDLLPath)/Unity.Burst.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDLLPath)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><HintPath>$(ManagedDLLPath)/Colossal.UI.Binding.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(ManagedDLLPath)/Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDLLPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The .NET Framework reference pack is only used to satisfy the SDK's framework check; every class-library
       reference that reaches the compiler comes from the game's Managed folder. -->
  <Target Name="UseGameClassLibrariesOnly" AfterTargets="ResolveAssemblyReferences;FindReferenceAssembliesForReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_JRGameClassLib Include="$(ManagedDLLPath)/mscorlib.dll;$(ManagedDLLPath)/System.dll;$(ManagedDLLPath)/System.Core.dll;$(ManagedDLLPath)/netstandard.dll" />
      <ReferencePath Remove="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.Identity)').ToLowerInvariant().Contains('referenceassemblies'))" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" Condition="$([System.String]::Copy('%(ReferencePathWithRefAssemblies.Identity)').ToLowerInvariant().Contains('referenceassemblies'))" />
      <ReferencePath Remove="@(_JRGameClassLib)" />
      <ReferencePathWithRefAssemblies Remove="@(_JRGameClassLib)" />
      <ReferencePath Include="@(_JRGameClassLib)" />
      <ReferencePathWithRefAssemblies Include="@(_JRGameClassLib)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDLLPath)/Game.dll')"
           Text="Cities: Skylines II not found (looked in '$(GamePath)'). Set CS2_PATH to the game install folder, or pass -p:GamePath=&quot;.../Cities Skylines II&quot;." />
  </Target>

  <!-- Burst build (opt-in): dotnet build -p:Burst=true. Needs the CSII_* toolchain env vars
       (~/.config/environment.d/60-cs2-modding.conf on Linux). Runs the official ModPostProcessor as the
       toolchain's Mod.targets does; it writes JunctionRules_win_x86_64.dll (the Burst code) beside the assembly. -->
  <PropertyGroup Condition="'$(Burst)' == 'true'">
    <DefineConstants>$(DefineConstants);JUNCTIONRULES_BURST</DefineConstants>
  </PropertyGroup>
  <!-- 1.0.0: unconditional, because a publish profile sets Burst=true only after this file's property groups have been
       evaluated (the SDK imports the .pubxml later); the targets below read Burst when they run, so they see it. -->
  <PropertyGroup>
    <ModPostProcessorPath Condition="'$(ModPostProcessorPath)' == ''">$(CSII_MODPOSTPROCESSORPATH)</ModPostProcessorPath>
    <UnityModProjectPath Condition="'$(UnityModProjectPath)' == ''">$(CSII_UNITYMODPROJECTPATH)</UnityModProjectPath>
  </PropertyGroup>

  <!-- Game closed only. ModPostProcessor.sh runs Proton Experimental's wine inside the game's own Proton prefix
       (compatdata/949230, hard-coded WINEPREFIX in the generated script) while the game may be running there under
       another Proton (11.0): two wineservers of different versions on one prefix. So a Burst build refuses to start
       while a Cities2.exe process exists. Override (at your own risk): -p:AllowBurstWhileGameRuns=true.
       The check is the owner's standard one, `ps -eo comm | grep -i cities2` (process names only, so it never
       matches the shell that runs it; `pgrep -f` can). -->

  <Target Name="RefuseBurstWhileGameRuns" BeforeTargets="BeforeBuild;BurstPostProcess"
          Condition="'$(Burst)' == 'true' And '$(AllowBurstWhileGameRuns)' != 'true' And $([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="ps -eo comm | grep -qi cities2" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_JRGameRunningExit" />
    </Exec>
    <Error Condition="'$(_JRGameRunningExit)' == '0'"
           Text="Cities: Skylines II is running (ps -eo comm | grep -i cities2 found it). The Burst post-processor runs wine inside the game's Proton prefix: build with the game closed only. Quit the game and build again (override at your own risk: -p:AllowBurstWhileGameRuns=true)." />
    <Error Condition="'$(_JRGameRunningExit)' != '0' And '$(_JRGameRunningExit)' != '1'"
           Text="Could not check whether Cities: Skylines II is running (grep exit code $(_JRGameRunningExit)). Refusing the Burst build; override at your own risk: -p:AllowBurstWhileGameRuns=true." />
  </Target>

  <Target Name="BurstPostProcess" AfterTargets="Build" BeforeTargets="DeployToLocalMods" Condition="'$(Burst)' == 'true'">
    <Error Condition="!Exists('$(ModPostProcessorPath)')" Text="Burst=true but CSII_MODPOSTPROCESSORPATH ('$(ModPostProcessorPath)') does not exist. Load the toolchain env vars first." />
    <Error Condition="!Exists('$(UnityModProjectPath)')" Text="Burst=true but CSII_UNITYMODPROJECTPATH ('$(UnityModProjectPath)') does not exist." />
    <Exec Command="&quot;$(ModPostProcessorPath)&quot; PostProcess &quot;$(TargetPath)&quot; -u &quot;$(UnityModProjectPath)&quot; @(ReferencePath->'-r &quot;%(Identity)&quot;', ' ') -p Windows -d -v" />
  </Target>

  <!-- Never runs unless -p:Deploy=true (and not -p:SkipDeploy=true). -->
  <Target Name="DeployToLocalMods" AfterTargets="Build" Condition="'$(Deploy)' == 'true' And '$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(ModDeployPath)" />
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(TargetName)_win_x86_64.dll" Condition="'$(Burst)' == 'true'" />
      <DeployFiles Include="$(TargetDir)$(TargetName).dll" />
      <DeployFiles Include="$(MSBuildProjectDirectory)/UI/JunctionRules.mjs" />
      <DeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(ModDeployPath)" />
    <Message Importance="high" Text="JunctionRules deployed to $(ModDeployPath)" />
  </Target>

  <!-- 0.4.0-probe: the UI module (toolbar button of the yellow box tool) lands next to the dll in every build output
       (also with -o), so the staged folder carries it. -->
  <ItemGroup>
    <None Include="UI/JunctionRules.mjs" Link="JunctionRules.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ===== Publishing to Paradox Mods (1.0.0) =====
       Same files and commands as the official CS2 mod template (Properties/PublishConfiguration.xml,
       Properties/PublishProfiles/*.pubxml with ModPublisherCommand Publish / NewVersion / Update, ModPublisher args
       "<command> <config> -c <content> -v"), run from the project folder:
         dotnet publish -c Release -p:PublishProfile=PublishNewMod        (first upload; then commit the printed ModId)
         dotnet publish -c Release -p:PublishProfile=PublishNewVersion    (later versions: bump ModVersion + ChangeLog)
         dotnet publish -c Release -p:PublishProfile=UpdatePublishedConfiguration   (texts / images only)
       Add -p:PublishDryRun=true to validate the configuration without logging in or uploading.
       Why not import the toolchain's Mod.props / Mod.targets: they switch the project to net48 and the toolchain's own
       references, clear the output folder, post-process for Windows + macOS + Linux and deploy by deleting and refilling
       the live Mods/JunctionRules folder (the installed build). Here the profile's Burst=true runs this project's own
       Windows Burst build (BurstPostProcess above, game closed only), the upload content is staged in
       bin/PublishContent/JunctionRules (the same five files the probe installs used), and ModPublisher is called the way
       Mod.targets calls it. ModPublisher logs in with the Paradox account the game last logged in with (no password
       prompt; without a saved game sign-in pass -p:ModPublisherExtraArgs="(dash-dash)noAutoLogin -l /abs/path/login.txt" (see README), a file with
       the email on line 1 and the password on line 2); it runs under Wine in the game's Proton prefix, which is one more reason the game must be closed. -->
  <PropertyGroup>
    <PublishConfigurationPath Condition="'$(PublishConfigurationPath)' == ''">Properties\PublishConfiguration.xml</PublishConfigurationPath>
    <ModPublisherPath Condition="'$(ModPublisherPath)' == ''">$(CSII_MODPUBLISHERPATH)</ModPublisherPath>
    <JRPublishContentDir>$(MSBuildProjectDirectory)/bin/PublishContent/JunctionRules</JRPublishContentDir>
  </PropertyGroup>

  <!-- Fails before the (long) build when a publish could not work. -->
  <Target Name="JRPublishChecks" BeforeTargets="BeforeBuild;Publish" Condition="'$(ModPublisherCommand)' != ''">
    <PropertyGroup>
      <JRPublishConfigFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(PublishConfigurationPath.Replace('\','/'))'))</JRPublishConfigFullPath>
    </PropertyGroup>
    <Error Condition="'$(Configuration)' != 'Release'" Text="Publishing needs a Release build: run dotnet publish -c Release -p:PublishProfile=$(PublishProfile) (the profile's Configuration=Release comes too late for the output path)." />
    <Error Condition="'$(Burst)' != 'true' And '$(PublishDryRun)' != 'true'" Text="Publishing needs the Burst build (Burst=true, set by the publish profiles in Properties/PublishProfiles)." />
    <Warning Condition="'$(Burst)' != 'true' And '$(PublishDryRun)' == 'true'" Text="Dry run without the Burst build: the Burst files are left out of the staged content (nothing is uploaded in a dry run)." />
    <Error Condition="'$(ModPublisherPath)' == '' Or !Exists('$(ModPublisherPath)')" Text="ModPublisher not found ('$(ModPublisherPath)'). Load the modding toolchain env vars (CSII_MODPUBLISHERPATH, ~/.config/environment.d/60-cs2-modding.conf) or pass -p:ModPublisherPath=..." />
    <Error Condition="!Exists('$(JRPublishConfigFullPath)')" Text="Publish configuration not found: $(JRPublishConfigFullPath)" />
  </Target>

  <Target Name="JRPublishToParadoxMods" AfterTargets="Publish" Condition="'$(ModPublisherCommand)' != ''">
    <ItemGroup>
      <JRPublishContent Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb;$(TargetDir)JunctionRules.mjs" />
      <JRPublishContent Include="$(TargetDir)$(TargetName)_win_x86_64.dll;$(TargetDir)$(TargetName)_win_x86_64.pdb" Condition="'$(Burst)' == 'true'" />
    </ItemGroup>
    <Error Condition="!Exists('%(JRPublishContent.FullPath)')" Text="Upload content missing: %(JRPublishContent.FullPath) (the Burst build did not produce it)." />
    <RemoveDir Directories="$(JRPublishContentDir)" />
    <Copy SourceFiles="@(JRPublishContent)" DestinationFolder="$(JRPublishContentDir)" />
    <!-- As Mod.targets' CheckPublishFilesAction: the SDK's own publish folder is not the upload content. -->
    <RemoveDir Directories="$(PublishDir)" Condition="'$(PublishDir)' != '$(OutDir)'" />
    <PropertyGroup>
      <JRModPublisherArgs>"$(ModPublisherPath)" $(ModPublisherCommand) "$(JRPublishConfigFullPath)" -c "$(JRPublishContentDir)" -v $(ModPublisherExtraArgs)</JRModPublisherArgs>
      <!-- Dry run: ModPublisher's own validation of the whole configuration runs, then sandbox mode stops it before it
           creates a session, logs in or uploads (it answers "Not supported in release mode"). -->
      <JRModPublisherArgs Condition="'$(PublishDryRun)' == 'true'">$(JRModPublisherArgs) --sandbox</JRModPublisherArgs>
    </PropertyGroup>
    <Message Importance="high" Text="Upload content: $(JRPublishContentDir)" />
    <Message Importance="high" Text="Run mod publisher: $(JRModPublisherArgs)" />
    <Exec Command="$(JRModPublisherArgs)" Condition="'$(PublishDryRun)' != 'true'" LogStandardErrorAsError="true" />
    <Exec Command="$(JRModPublisherArgs)" Condition="'$(PublishDryRun)' == 'true'" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="high">
      <Output TaskParameter="ConsoleOutput" PropertyName="_JRDryRunOutput" />
    </Exec>
    <Error Condition="'$(PublishDryRun)' == 'true' And ('$(_JRDryRunOutput.Contains(`Error while processing args`))' == 'True' Or '$(_JRDryRunOutput.Contains(`Not supported in release mode`))' != 'True')" Text="Dry run: ModPublisher rejected the configuration (see its output above)." />
    <Message Importance="high" Condition="'$(PublishDryRun)' == 'true'" Text="Dry run OK: ModPublisher accepted the configuration and stopped before logging in. Nothing was uploaded." />
  </Target>
</Project>
